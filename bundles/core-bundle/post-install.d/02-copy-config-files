#!/bin/sh
#
# This script copies some configuration file from current running system
# to the updated partition (new system).
#

SLOT_CLASS="$1"
SLOT_MOUNT_POINT="$2"
BUNDLE_MOUNT_POINT="$3"

# print root's home directory as configured in the passwd file below $1
root_home() {
	grep '^root:' "$1/etc/passwd" | cut -d: -f6
}

if [ "$SLOT_CLASS" = "rootfs" ]; then
	# source helper
	. "$BUNDLE_MOUNT_POINT/post-install.d/00-tar-helper"

	( xargs tar -c $IGNORE_FAILED_READ -C / ) <<-EOF | tar -x -C "$SLOT_MOUNT_POINT"
	/etc/hostname
	/etc/hosts
	/etc/machine-id
	/etc/localtime
	/etc/timezone
	/etc/ssh/ssh_host_ecdsa_key
	/etc/ssh/ssh_host_ecdsa_key.pub
	/etc/ssh/ssh_host_ed25519_key
	/etc/ssh/ssh_host_ed25519_key.pub
	/etc/ssh/ssh_host_rsa_key
	/etc/ssh/ssh_host_rsa_key.pub
	/etc/systemd/network
	/etc/hostapd/hostapd.conf
	/etc/wpa_supplicant
	EOF

	# we need to check whether we have already a system with usually clean directory
	# otherwise we would copy over all the undesired standard stuff
	if [ -f /etc/systemd/system/.keep-during-fw-update ]; then
		( xargs tar -c $IGNORE_FAILED_READ -C / ) <<-EOF | tar -x -C "$SLOT_MOUNT_POINT"
		/etc/systemd/system
		EOF
	fi

	# copy /etc/resolv.conf only if it is a plain file and not a link;
	# copy it also only when not migrating from Debian based OS to Yocto
	if [ -f /etc/resolv.conf -a ! -L /etc/resolv.conf -a ! -f /etc/debian_version ]; then
		rm -f "$SLOT_MOUNT_POINT/etc/resolv.conf"
		cat /etc/resolv.conf > "$SLOT_MOUNT_POINT/etc/resolv.conf"
	fi

	# root's home moved from /home/root (kirkstone) to /root (wrynose), so
	# look it up on both sides to migrate every old/new combination correctly
	SRC_ROOT_HOME="$(root_home)"
	DST_ROOT_HOME="$(root_home "$SLOT_MOUNT_POINT")"
	if [ -n "$SRC_ROOT_HOME" ] && [ -n "$DST_ROOT_HOME" ]; then
		mkdir -p "$SLOT_MOUNT_POINT$DST_ROOT_HOME"

		# migrate .ssh of even older systems which used /root while the
		# current system uses another home directory
		if [ "$SRC_ROOT_HOME" != "/root" ] && [ -d /root/.ssh ]; then
			tar -c $IGNORE_FAILED_READ -C /root .ssh | tar -x -C "$SLOT_MOUNT_POINT$DST_ROOT_HOME"
		fi

		tar -c $IGNORE_FAILED_READ -C "$SRC_ROOT_HOME" .ssh .config .bash_history | \
			tar -x -C "$SLOT_MOUNT_POINT$DST_ROOT_HOME"
	fi
fi
